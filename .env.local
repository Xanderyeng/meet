# ─────────────────────────────────────────────────────────────────────────────
# Meet — Local WSL2 environment variables
# Copy this file:  cp .env.local .env
# Then start:      docker compose -f compose.local.yml up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_PASSWORD=password

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=ThisIsAnExampleKeyForLocalDevOnly_ChangeMe

# ── OIDC (must match client secret configured in Keycloak realm) ──────────────
# The realm.json in docker/auth sets this to "ThisIsAnExampleKeyForDevPurposeOnly"
OIDC_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=localkey
LIVEKIT_API_SECRET=localsecret

# ── MinIO (object storage for recordings) ────────────────────────────────────
MINIO_USER=meet
MINIO_PASSWORD=password

# ── Email (optional — leave blank to skip sending) ────────────────────────────
# To enable a local mail catcher add mailpit to the compose and set:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=meet@localhost
